# Inbox that receives contact form messages
CONTACT_TO_EMAIL=hello@yasinmalak.dev

# Option A — Resend (https://resend.com). Verified domain required for custom from-address.
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FROM_EMAIL=Yasin Malak <hello@yasinmalak.dev>

# Option B — Web3Forms (https://web3forms.com). Easiest free setup: one access key, messages arrive at your email.
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
